{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --python \">=3.11\" python \"${CLAUDE_PLUGIN_ROOT}/orb/session_hook.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "uv run --no-project --python \">=3.11\" python \"${CLAUDE_PLUGIN_ROOT}/orb/turn_hook.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --python \">=3.11\" python \"${CLAUDE_PLUGIN_ROOT}/orb/stop_hook.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "uv run --no-project --python \">=3.11\" python \"${CLAUDE_PLUGIN_ROOT}/orb/turn_hook.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --python \">=3.11\" python \"${CLAUDE_PLUGIN_ROOT}/orb/turn_hook.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --python \">=3.11\" python \"${CLAUDE_PLUGIN_ROOT}/orb/turn_hook.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --python \">=3.11\" python \"${CLAUDE_PLUGIN_ROOT}/orb/turn_hook.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
